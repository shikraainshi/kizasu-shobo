# サイトURL（LINE通知・Stripeのリダイレクト先構築に使用）
SITE_URL=https://kizasu-shobo.jp

# LINE公式アカウント（Messaging API）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LIFF（イベント申込・決済フローで使用。未設定時はLINEトークへの通知は無効になる）
NEXT_PUBLIC_LIFF_ID=

# Firebase Admin SDK（Firestore / Storage、サーバー側のみで使用）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 秘密鍵はVercel等のUIで貼り付けると改行(\n)が壊れやすいため、base64エンコードした値を推奨する。
# 例: node -e "console.log(Buffer.from(fs.readFileSync('service-account.json')).toString())" ではなく、
#     秘密鍵の中身（-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----）をbase64化して設定する。
FIREBASE_PRIVATE_KEY_BASE64=
# ローカル開発では従来通り\n区切りの秘密鍵でも動作する（FIREBASE_PRIVATE_KEY_BASE64が無い場合のみ使用）
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Stripe（イベント参加費のオンライン決済。Checkoutのみ使用しクライアントに鍵は出さない）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notion（書籍・お知らせデータ）
NOTION_API_KEY=
NOTION_BOOKS_DB_ID=
NOTION_NEWS_DB_ID=

# 管理画面（/admin）
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# お問い合わせフォームのメール送信
RESEND_API_KEY=
